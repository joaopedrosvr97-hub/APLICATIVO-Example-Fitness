# Exemplo de variáveis de ambiente.
# Copie para .env e preencha com valores locais reais.

DATABASE_URL=postgres://username:password@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-secret
TRPC_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_SERVER_URL=http://localhost:3000
EXPO_PUBLIC_APP_ID=f3fitness
EXPO_PUBLIC_OAUTH_PORTAL_URL=http://localhost:8081
EXPO_PUBLIC_OAUTH_SERVER_URL=http://localhost:3000
EXPO_PUBLIC_OWNER_OPEN_ID=your-openid
EXPO_PUBLIC_OWNER_NAME=Owner Name
BUILT_IN_FORGE_API_URL=https://your-api.example.com
BUILT_IN_FORGE_API_KEY=replace-with-api-key
PORT=3000
NODE_ENV=development
